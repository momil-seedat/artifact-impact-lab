    {
      "id": "R1",
      "type": "requirement",
      "name": "R1 \u2014 Payment must time out",
      "file": "requirements/payment_requirements.md",
      "line": 18,
      "text": "R1 \u2014 Payment must time out A payment attempt MUST abort if the payment gateway does not respond within a configurable timeout. The timeout is controlled by the `payment.timeout` configuration property and is consumed by the payment service when it processes a payment."
    },
    {
      "id": "R2",
      "type": "requirement",
      "name": "R2 \u2014 Payments must be retried",
      "file": "requirements/payment_requirements.md",
      "line": 28,
      "text": "R2 \u2014 Payments must be retried A failed payment MUST be retried up to a configurable number of times, governed by the `payment.retry.count` configuration property."
    },
    {
      "id": "R3",
      "type": "requirement",
      "name": "R3 \u2014 Payments target a configured gateway",
      "file": "requirements/payment_requirements.md",
      "line": 36,
      "text": "R3 \u2014 Payments target a configured gateway All payments MUST be sent to the gateway identified by the `payment.gateway.url` configuration property."
    },
